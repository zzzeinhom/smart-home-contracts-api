# Upstream OpenAI-Compatible AI Provider
AI_BASE_URL=https://api.example.com
AI_API_KEY=changeme
AI_CHAT_MODEL=chat-model
AI_VISION_MODEL=vision-model
AI_EMBEDDING_MODEL=embedding-model
AI_EMBEDDING_DIMENSIONS=1024
AI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
AI_EMBEDDINGS_PATH=/v1/embeddings

# PostgreSQL (PGVector)
DB_URL=jdbc:postgresql://localhost:5432/contracts_db
DB_USER=app_user
DB_PASSWORD=app_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server & MCP Operations Server
SERVER_PORT=8080
MCP_SERVER_URL=http://localhost:8081
MCP_SERVER_PORT=8081

# API Key Security & Optional Startup Bootstrap (generate high-entropy secrets in production)
APP_ADMIN_KEY=replace-with-strong-admin-key
APP_BOOTSTRAP_API_KEY=
APP_BOOTSTRAP_TENANT_ID=smart-power
